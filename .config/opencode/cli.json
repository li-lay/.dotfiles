{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "gruvbox",
    "mode": "dark"
  },
  "animations": true,
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "verbosity": "high",
    "image_preview": true,
    "permissions": "autoaccept"
  },
  "tabs": {
    "mode": "auto",
    "layout": "horizontal",
    "indicators": "status"
  },
  "diffs": {
    "wrap": "word"
  },
  "scroll": {
    "acceleration": false
  },
  "mouse": true,
  "prompt": {
    "image_preview": true
  },
  "attention": {
    "notifications": true
  }
}
