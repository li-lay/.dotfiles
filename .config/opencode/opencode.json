{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "default_agent": "orchestrator",
  "shell": "/bin/bash",
  "formatter": true,
  "websearch": {
    "provider": "random"
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 60000
    },
    "buffer": 40000
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{file:~/.config/opencode/.secrets/context7-key}"
      }
    }
  }
}
